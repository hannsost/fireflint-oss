{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fullnameOverride",
    "imagePullSecrets",
    "runtime",
    "api",
    "admin",
    "assets",
    "ingress",
    "networkPolicy",
    "nodeSelector",
    "tolerations",
    "bootstrap",
    "database"
  ],
  "properties": {
    "fullnameOverride": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret",
        "aiAllowedProviderHosts"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "aiAllowedProviderHosts": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "campaigns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispatchExistingSecret",
        "dispatchSecretKey",
        "ingressPeers"
      ],
      "properties": {
        "dispatchExistingSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 253
        },
        "dispatchSecretKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9._-]+$"
        },
        "ingressPeers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "namespaceSelector",
              "podSelector"
            ],
            "properties": {
              "namespaceSelector": {
                "type": "object",
                "minProperties": 1
              },
              "podSelector": {
                "type": "object",
                "minProperties": 1
              }
            }
          }
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "image",
        "resources",
        "startupProbe",
        "readinessProbe",
        "livenessProbe",
        "terminationGracePeriodSeconds"
      ],
      "properties": {
        "replicas": {
          "const": 1
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "digest",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9./:_-]+$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ],
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ],
              "additionalProperties": {
                "type": "string"
              }
            },
            "limits": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ],
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "startupProbe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "periodSeconds",
            "timeoutSeconds",
            "failureThreshold"
          ],
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "readinessProbe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "periodSeconds",
            "timeoutSeconds",
            "failureThreshold"
          ],
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "livenessProbe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "periodSeconds",
            "timeoutSeconds",
            "failureThreshold"
          ],
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 600
        }
      }
    },
    "admin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "resources"
      ],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "digest",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9./:_-]+$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ],
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ],
              "additionalProperties": {
                "type": "string"
              }
            },
            "limits": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ],
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingClaim",
        "storageClass",
        "size",
        "accessMode"
      ],
      "properties": {
        "existingClaim": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
        },
        "accessMode": {
          "enum": [
            "ReadWriteOnce",
            "ReadWriteOncePod"
          ]
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "className",
        "host",
        "tlsSecretName",
        "annotations"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",
          "minLength": 1,
          "maxLength": 253
        },
        "tlsSecretName": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "ingressPeers",
        "databasePeers",
        "databasePort",
        "dnsNamespace",
        "dnsPodLabels",
        "allowPublicHTTPS"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressPeers": {
          "type": "array",
          "items": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "namespaceSelector": {
                "type": "object"
              },
              "podSelector": {
                "type": "object"
              },
              "ipBlock": {
                "type": "object",
                "required": [
                  "cidr"
                ],
                "properties": {
                  "cidr": {
                    "type": "string",
                    "minLength": 1
                  },
                  "except": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "databasePeers": {
          "type": "array",
          "items": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "namespaceSelector": {
                "type": "object"
              },
              "podSelector": {
                "type": "object"
              },
              "ipBlock": {
                "type": "object",
                "required": [
                  "cidr"
                ],
                "properties": {
                  "cidr": {
                    "type": "string",
                    "minLength": 1
                  },
                  "except": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "databasePort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "dnsNamespace": {
          "type": "string",
          "minLength": 1
        },
        "dnsPodLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1
        },
        "allowPublicHTTPS": {
          "type": "boolean"
        },
        "oidcPeers": {
          "type": "array",
          "items": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "namespaceSelector": {
                "type": "object"
              },
              "podSelector": {
                "type": "object"
              },
              "ipBlock": {
                "type": "object",
                "required": [
                  "cidr"
                ],
                "properties": {
                  "cidr": {
                    "type": "string",
                    "minLength": 1
                  },
                  "except": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "oidcPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "existingSecret",
        "runId"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string"
        },
        "runId": {
          "type": "string",
          "maxLength": 12,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caSecret",
        "caKey"
      ],
      "properties": {
        "caSecret": {
          "type": "string"
        },
        "caKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "requireAppGroup",
        "issuerUrl",
        "clientId",
        "label",
        "existingSecret",
        "clientSecretKey"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "requireAppGroup": {
          "type": "boolean"
        },
        "issuerUrl": {
          "type": "string",
          "pattern": "^$|^https://[^?# ]+$"
        },
        "clientId": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "existingSecret": {
          "type": "string"
        },
        "clientSecretKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "instagram": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "existingSecret",
        "appIdSecretKey",
        "appSecretKey",
        "apiVersion",
        "loginMode",
        "configurationId",
        "webhookVerifyTokenSecretKey"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 253
        },
        "appIdSecretKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9._-]+$"
        },
        "appSecretKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9._-]+$"
        },
        "apiVersion": {
          "type": "string",
          "pattern": "^$|^v[0-9]{1,3}\\.[0-9]{1,3}$"
        },
        "loginMode": {
          "type": "string",
          "enum": [
            "instagram_login",
            "unified"
          ]
        },
        "configurationId": {
          "type": "string",
          "pattern": "^$|^[0-9]+$",
          "maxLength": 80
        },
        "webhookVerifyTokenSecretKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9._-]+$"
        }
      }
    }
  }
}
