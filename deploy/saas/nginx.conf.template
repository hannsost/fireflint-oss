worker_processes auto;
pid /tmp/nginx.pid;
# Nginx error entries may contain the full request query (preview tokens).
# Use API request IDs/status telemetry; keep unredacted nginx errors disabled.
error_log /dev/null crit;
events { worker_connections 1024; }
http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  server_tokens off;
  client_body_temp_path /tmp/client_body;
  proxy_temp_path /tmp/proxy;
  fastcgi_temp_path /tmp/fastcgi;
  uwsgi_temp_path /tmp/uwsgi;
  scgi_temp_path /tmp/scgi;
  # Deliberately omit request URI/query, Authorization, referrer and body.
  log_format safe '$request_method $uri $status $body_bytes_sent $request_time';
  access_log /dev/stdout safe;
  # A global capacity limit, not a claim about client IP behind an ingress.
  limit_req_zone $server_name zone=login:1m rate=5r/s;
  limit_req_status 429;
  upstream fireflint { server ${API_UPSTREAM}; }
  server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    client_max_body_size 25m;
    include /etc/fireflint/security-headers.conf;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 180s;
    proxy_send_timeout 180s;
    proxy_cache off;
    proxy_buffering off;

    location = /healthz { access_log off; return 200 'ok\n'; }
    location = /readyz { proxy_pass http://fireflint; }
    location = /auth/login {
      client_max_body_size 8k;
      limit_req zone=login burst=20 nodelay;
      proxy_hide_header Cache-Control;
      add_header Cache-Control 'private, no-store' always;
      include /etc/fireflint/security-headers.conf;
      proxy_pass http://fireflint;
    }
    location ~ ^/(api|auth|v1|preview|forms|hub/v1)(/|$) {
      proxy_hide_header Cache-Control;
      add_header Cache-Control 'private, no-store' always;
      include /etc/fireflint/security-headers.conf;
      proxy_pass http://fireflint;
    }
    location ~ ^/(version|openapi\.json)$ {
      proxy_hide_header Cache-Control;
      add_header Cache-Control 'no-store' always;
      include /etc/fireflint/security-headers.conf;
      proxy_pass http://fireflint;
    }
    location /assets/ {
      # API enforces safe MIME/disposition; keep its asset response headers.
      proxy_pass http://fireflint;
    }
    location /_static/ {
      try_files $uri =404;
      add_header Cache-Control 'public, max-age=31536000, immutable';
      include /etc/fireflint/security-headers.conf;
    }
    location / {
      add_header Cache-Control 'no-store' always;
      include /etc/fireflint/security-headers.conf;
      try_files $uri /index.html;
    }
  }
}
