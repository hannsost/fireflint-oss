# Copy to .env (repo root) or export these before `cargo run`.

# --- Core ---
DATABASE_URL=postgres://sitegraph:sitegraph@localhost:5432/sitegraph
# Core API bind address. Local dev uses :8090 (run-local.sh, systemd --user units,
# admin VITE_API_URL). The optional cluster-view BFF then uses :8091.
BIND=0.0.0.0:8090
RUST_LOG=info,sqlx=warn

# Secret for signing JWTs. MUST be a long random value in production.
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
# Required in production; use a stable random secret and keep it outside the repo.
AI_CONNECTOR_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32

# Set to "production" to enforce guardrails: refuses to start with the insecure
# default JWT_SECRET and recommends an explicit CORS allowlist.
APP_ENV=dev

# Comma-separated CORS origin allowlist. Empty = permissive (dev only).
# Example: CORS_ALLOWED_ORIGINS=https://admin.example.com,https://app.example.com
CORS_ALLOWED_ORIGINS=

# --- Media (v2) ---
# Directory for media blob storage (local backend).
ASSET_DIR=./data/assets

# --- Webhooks (v2) ---
# Dev only: allow webhook targets on loopback/private IPs (e.g. 127.0.0.1).
# Leave unset/false in production (SSRF guard blocks private targets).
WEBHOOK_ALLOW_PRIVATE=false

# --- AI providers (optional) ---
# AI connectors are created per organization in the admin UI ("KI-Agenten").
# Supported providers: "anthropic", "openai_compatible", "mock".
# "openai_compatible" talks to any OpenAI-compatible Chat Completions API —
# choose it with base_url + model, e.g.
#   OpenAI      https://api.openai.com/v1        gpt-4o-mini
#   Mistral     https://api.mistral.ai/v1        mistral-small-latest
#   OpenRouter  https://openrouter.ai/api/v1     anthropic/claude-sonnet-4
#   Ollama      http://localhost:11434/v1        llama3.2
#   LM Studio   http://localhost:1234/v1         <loaded model>
# api.anthropic.com and api.openai.com are approved by default; any other host
# must be listed here (comma-separated):
AI_ALLOWED_PROVIDER_HOSTS=
# Allow approved hosts on private networks/loopback over HTTP (local models).
# Keep false on internet-facing production systems unless you need it.
AI_ALLOW_PRIVATE_PROVIDERS=false
